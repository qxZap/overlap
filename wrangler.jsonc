// Cloudflare Workers static assets. No Worker script: every request is a static file,
// so requests are free and _headers applies to all of them.
{
  "name": "overlap",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public" },
  // Each deploy attaches the custom domain and creates its DNS record (the vibe-coding.fans zone is on this account).
  "routes": [{ "pattern": "overlap.vibe-coding.fans", "custom_domain": true }],
  // Only the custom domain serves the site: no *.workers.dev address, no preview URLs.
  "workers_dev": false,
  "preview_urls": false
}
